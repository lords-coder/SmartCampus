# SmartCampus AI backend - development environment
# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgresql://smartcampus:smartcampus_dev@localhost:5432/smartcampus

# Auth - generate a long random value for anything outside local dev
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRES_IN=1d

# CORS - frontend origin(s), comma separated
FRONTEND_URL=http://localhost:3000

BCRYPT_ROUNDS=10

# AI assistant (Phase 4)
# provider: auto (default) = OpenAI when OPENAI_API_KEY is set, otherwise the deterministic mock
AI_PROVIDER=auto
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_MAX_TOKENS=400
AI_MAX_MESSAGE_LENGTH=1000
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000

# ML inference service (Phase 5)
# The Express backend is the only caller; the browser never contacts this.
# Docker Compose service name: http://ml-service:8001
# Backend running on the host:     http://localhost:8001
ML_SERVICE_URL=http://localhost:8001
# Hard ceiling for the backend -> ML call. On timeout the prediction degrades
# to the rule-based estimate and says so via prediction_source.
ML_TIMEOUT_MS=5000
